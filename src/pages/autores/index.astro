---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { getCollection } from 'astro:content';
import { obtenerLibros } from '../../features/catalogo/libros';

const libros = await obtenerLibros();
const autores = (await getCollection('autores'))
  .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'))
  .map((autor) => ({ autor, titulos: libros.filter((l) => l.autor.id === autor.id).length }));
---

<Base titulo="Autores" descripcion="Las autoras y autores que publican con Editorial DT5.">
  <section class="franja">
    <h1>Autores</h1>
    <ul class="autores">
      {
        autores.map(({ autor, titulos }, i) => (
          <li class="aparece" style={`--retraso:${(i % 3) * 60}ms`}>
            <a href={`/autores/${autor.id}/`}>
              <span class="nombre">{autor.data.nombre}</span>
              <span class="detalle">
                {[autor.data.ciudad, titulos === 1 ? '1 libro' : `${titulos} libros`].filter(Boolean).join(' · ')}
              </span>
              <Icono nombre="flecha" tamano={22} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(40px, 6vw, 72px);
    letter-spacing: -0.03em;
    margin-bottom: clamp(24px, 4vw, 44px);
  }

  .autores {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--linea);
  }

  a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 8px 24px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--linea);
    text-decoration: none;
  }

  .nombre {
    font-family: var(--serif);
    font-size: clamp(26px, 3.4vw, 40px);
    color: var(--azul);
    transition: color 0.2s;
  }

  .detalle {
    color: var(--gris);
    font-size: 0.9375rem;
  }

  a :global(svg) {
    color: var(--naranja-txt);
    transition: transform 0.25s var(--ease);
  }

  a:hover .nombre {
    color: var(--naranja-txt);
  }

  a:hover :global(svg) {
    transform: translateX(6px);
  }

  @media (max-width: 640px) {
    a {
      grid-template-columns: 1fr auto;
    }

    .detalle {
      grid-row: 2;
    }

    a :global(svg) {
      grid-row: 1 / 3;
      grid-column: 2;
    }
  }
</style>
