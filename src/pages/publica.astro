---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { EDITORIAL } from '../data/editorial';

const pasos = [
  ['Prepara tu propuesta', 'Una carta breve sobre ti y tu obra, una sinopsis de una cuartilla y el manuscrito completo en PDF.'],
  ['Envíala por correo', 'Escribe a nuestro correo con el asunto "Manuscrito" y el título de tu obra.'],
  ['Espera nuestra respuesta', 'Leemos todas las propuestas. Te respondemos en un máximo de 8 semanas, aunque la respuesta sea no.'],
];

const correo = `mailto:${EDITORIAL.correo}?subject=${encodeURIComponent('Manuscrito: ')}`;
---

<Base titulo="Publica con nosotros" descripcion="Cómo enviar tu manuscrito a Editorial DT5.">
  <section class="franja">
    <h1>¿Tienes un manuscrito?</h1>
    <p class="lead">Buscamos narrativa, ensayo, poesía y libros infantiles escritos en español.</p>

    <ol class="pasos">
      {
        pasos.map(([titulo, texto], i) => (
          <li class="aparece" style={`--retraso:${i * 80}ms`}>
            <span class="numero">{i + 1}</span>
            <div>
              <h2>{titulo}</h2>
              <p>{texto}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <a class="boton" href={correo}><Icono nombre="correo" /> Enviar mi manuscrito</a>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(40px, 6.4vw, 84px);
    letter-spacing: -0.035em;
  }

  .pasos {
    display: grid;
    gap: 0;
    max-width: 760px;
    list-style: none;
    margin: clamp(28px, 5vw, 56px) 0;
    padding: 0;
    border-top: 1px solid var(--linea);
  }

  .pasos li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--linea);
  }

  .numero {
    font-family: var(--serif);
    font-size: 40px;
    line-height: 1;
    color: var(--naranja);
  }

  h2 {
    font-size: clamp(22px, 2.4vw, 28px);
  }

  .pasos p {
    margin: 8px 0 0;
    color: var(--gris);
  }
</style>
