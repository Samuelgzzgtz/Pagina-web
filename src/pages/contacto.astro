---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { EDITORIAL } from '../data/editorial';
import { enlaceLlamada, enlaceWhatsApp, formatearTelefono } from '../data/telefono';

const medios = [
  { icono: 'correo', nombre: 'Correo', valor: EDITORIAL.correo, href: `mailto:${EDITORIAL.correo}` },
  { icono: 'telefono', nombre: 'Teléfono', valor: formatearTelefono(EDITORIAL.telefono), href: enlaceLlamada(EDITORIAL.telefono) },
  { icono: 'whatsapp', nombre: 'WhatsApp', valor: 'Escríbenos', href: enlaceWhatsApp(EDITORIAL.telefono, 'Hola, DT5.') },
  { icono: 'ubicacion', nombre: 'Oficina', valor: EDITORIAL.ciudad },
] as const;
---

<Base titulo="Contacto" descripcion="Escríbenos o llámanos. Editorial DT5.">
  <section class="franja">
    <h1>Hablemos.</h1>
    <p class="lead">Para pedidos, presentaciones o dudas sobre un libro.</p>

    <ul class="medios">
      {
        medios.map((m, i) => (
          <li class="aparece" style={`--retraso:${i * 60}ms`}>
            <span class="nombre">
              <Icono nombre={m.icono} /> {m.nombre}
            </span>
            {'href' in m ? (
              <a class="valor" href={m.href} target={m.icono === 'whatsapp' ? '_blank' : undefined} rel="noopener">
                {m.valor}
              </a>
            ) : (
              <span class="valor">{m.valor}</span>
            )}
          </li>
        ))
      }
    </ul>

    <p class="red">
      ¿Buscas al colaborador de tu estado?
      <a class="enlace" href="/colaboradores/">Ver el mapa <Icono nombre="flecha" tamano={16} /></a>
    </p>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(44px, 7vw, 96px);
    letter-spacing: -0.035em;
  }

  .medios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0 clamp(24px, 4vw, 48px);
    list-style: none;
    margin: clamp(28px, 5vw, 56px) 0 0;
    padding: 0;
  }

  .medios li {
    padding: 22px 0;
    border-top: 1px solid var(--linea);
  }

  .nombre {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--gris);
    font-size: 0.9375rem;
  }

  .nombre :global(svg) {
    color: var(--naranja-txt);
  }

  .valor {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--serif);
    font-size: clamp(22px, 2.6vw, 30px);
    color: var(--azul);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a.valor:hover {
    color: var(--naranja-txt);
  }

  .red {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin: clamp(28px, 5vw, 48px) 0 0;
    color: var(--gris);
  }
</style>
