---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Portada from '../../features/catalogo/Portada.astro';
import ListaLibros from '../../features/catalogo/ListaLibros.astro';
import { mensajePedido, obtenerLibros, type Libro } from '../../features/catalogo/libros';
import { COLECCIONES, EDITORIAL } from '../../data/editorial';
import { enlaceWhatsApp } from '../../data/telefono';

export async function getStaticPaths() {
  const libros = await obtenerLibros();
  return libros.map((libro) => ({
    params: { libro: libro.id },
    props: {
      libro,
      relacionados: libros
        .filter((l) => l.id !== libro.id && (l.autor.id === libro.autor.id || l.data.coleccion === libro.data.coleccion))
        .slice(0, 4),
    },
  }));
}

interface Props {
  libro: Libro;
  relacionados: Libro[];
}

const { libro, relacionados } = Astro.props;
const { titulo, coleccion, anio, paginas, isbn } = libro.data;
const { Content } = await render(libro);
const datos = [
  ['Año', String(anio)],
  ['Páginas', paginas && String(paginas)],
  ['ISBN', isbn],
].filter((d): d is [string, string] => Boolean(d[1]));
const pedido = mensajePedido(libro);
---

<Base titulo={titulo} descripcion={`${titulo}, de ${libro.autor.data.nombre}. Editorial DT5.`}>
  <article class="franja ficha">
    <div class="ficha-portada">
      <Portada libro={libro} ancho={560} />
    </div>
    <div class="ficha-texto">
      <a class="coleccion" href={`/catalogo/${coleccion}/`}>{COLECCIONES[coleccion]}</a>
      <h1>{titulo}</h1>
      <a class="autor" href={`/autores/${libro.autor.id}/`}>{libro.autor.data.nombre}</a>
      <div class="prosa sinopsis"><Content /></div>
      <div class="acciones">
        <a class="boton" href={enlaceWhatsApp(EDITORIAL.telefono, pedido)} target="_blank" rel="noopener">
          <Icono nombre="whatsapp" /> Pedir por WhatsApp
        </a>
        <a
          class="boton borde"
          href={`mailto:${EDITORIAL.correo}?subject=${encodeURIComponent(`Pedido: ${titulo}`)}&body=${encodeURIComponent(pedido)}`}
        >
          <Icono nombre="correo" /> Pedir por correo
        </a>
      </div>
      <dl class="datos">
        {
          datos.map(([nombre, valor]) => (
            <div>
              <dt>{nombre}</dt>
              <dd>{valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </article>

  {
    relacionados.length > 0 && (
      <section class="franja sin-arriba">
        <h2 class="titulo-seccion relacionados">También te puede gustar</h2>
        <ListaLibros libros={relacionados} fila />
      </section>
    )
  }
</Base>

<style>
  .ficha {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 80px);
    align-items: start;
  }

  .ficha-portada {
    position: sticky;
    top: 96px;
    max-width: 440px;
  }

  .coleccion {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--naranja-txt);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  h1 {
    margin-top: 2px;
    font-size: clamp(38px, 5.4vw, 68px);
    letter-spacing: -0.03em;
  }

  .autor {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--serif);
    font-size: clamp(20px, 2.2vw, 26px);
    color: var(--azul);
    text-underline-offset: 5px;
  }

  .sinopsis {
    margin-top: 28px;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .datos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
    margin: 36px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--linea);
  }

  .datos dt {
    color: var(--gris);
    font-size: 0.875rem;
  }

  .datos dd {
    margin: 2px 0 0;
    font-weight: 500;
  }

  .sin-arriba {
    padding-top: 0;
  }

  .relacionados {
    margin-bottom: 28px;
  }

  @media (max-width: 760px) {
    .ficha {
      grid-template-columns: 1fr;
    }

    .ficha-portada {
      position: static;
      width: min(55%, 220px);
    }
  }
</style>
