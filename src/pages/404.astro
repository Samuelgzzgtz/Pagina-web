---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
---

<Base titulo="Página no encontrada">
  <section class="franja">
    <p class="codigo">404</p>
    <h1>Esta página se quedó sin imprimir.</h1>
    <p class="lead">Puede que el enlace esté mal escrito o que la página ya no exista.</p>
    <div class="acciones">
      <a class="boton" href="/">Ir al inicio <Icono nombre="flecha" /></a>
      <a class="enlace" href="/catalogo/">Ver el catálogo</a>
    </div>
  </section>
</Base>

<style>
  .codigo {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(72px, 14vw, 180px);
    line-height: 1;
    color: var(--naranja);
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(32px, 4.4vw, 56px);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    margin-top: 28px;
  }
</style>
