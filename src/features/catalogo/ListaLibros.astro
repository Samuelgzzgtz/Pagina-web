---
import Portada from './Portada.astro';
import type { Libro } from './libros';

interface Props {
  libros: Libro[];
  // Fila fija de 4 (2 en celular) para secciones cortas como Novedades.
  fila?: boolean;
}

const { libros, fila = false } = Astro.props;
---

<ul class:list={['lista', { fila }]}>
  {
    libros.map((libro, i) => (
      <li class="aparece" style={`--retraso:${(i % 4) * 70}ms`}>
        <a href={`/libros/${libro.id}/`}>
          <Portada libro={libro} decorativa />
          <span class="titulo">{libro.data.titulo}</span>
          <span class="autor">{libro.autor.data.nombre}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(160px, 40vw), 1fr));
    gap: clamp(20px, 3vw, 36px) clamp(16px, 2.5vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fila {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 640px) {
    .fila {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  a {
    display: block;
    text-decoration: none;
  }

  a :global(.portada) {
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }

  @media (hover: hover) {
    a:hover :global(.portada) {
      transform: translateY(-6px);
      box-shadow: 0 26px 34px -14px #1b2f6b80;
    }
  }

  .titulo {
    display: block;
    margin-top: 14px;
    font-weight: 500;
    line-height: 1.3;
  }

  .autor {
    color: var(--gris);
    font-size: 0.875rem;
  }
</style>
